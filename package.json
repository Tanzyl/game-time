    "build": "cd client && npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.19.0",
    "socket.io": "^4.7.0"
  },
  "pkg": {
    "assets": [
      "client/dist/**/*",
      "server/questions.json"
    ]
  },
  "devDependencies": {
    "localtunnel": "^2.0.2",
    "socket.io-client": "^4.7.0"
  }
}
