{
  "name": "game-time",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:server": "node server/index.js",
    "build:exe": "npm run build && npx @yao-pkg/pkg server/index.js --config package.json --targets node22-win-x64 --output GuessTheirAnswer.exe",
